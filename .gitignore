
# Local agent credentials
.insta/agent-session.json

.insta/.agent-session-*.tmp

# Local: the control plane this machine linked against
.insta/link-plane.json

# InstaCloud: local observe-hook state (regenerated per machine, not source)
.insta/observe/
.insta/audit.jsonl

# InstaCloud: agent skills installed by `npx skills add` (regenerable, not source)
.claude/skills/
.agents/skills/
.github/skills/
skills-lock.json

# Agent tool state (installed skills, local settings)
.codex/
.claude/settings.json
